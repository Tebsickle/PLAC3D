# Public deployment
PUBLIC_HOSTNAME=plac3d.example.com
APP_ORIGIN=https://plac3d.example.com

# Local application ports
APP_PORT=5173
PORT=8787

# Storage and session security
DATABASE_PATH=./data/plac3d.db
DOCKER_DATABASE_PATH=/app/data/plac3d.db
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL="PLAC3D <noreply@mail.example.com>"
